GEMINI_API_KEY=
# опционально: запасные ключи через запятую, переход при исчерпании квоты или отказе ключа
GEMINI_API_KEYS_RESERVE=
# закреплённая версия (16.10.2026: 3.8-flash/flash-latest перегружены — 503/504, 2.5-flash — 404);
# псевдоним *-latest не использовать: модель сменится молча и метрики eval поплывут
GEMINI_MODEL=gemini-3.5-flash
# запасной провайдер, пока не реализован
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CREDENTIALS_FILE=secrets/credentials.json
GOOGLE_TOKEN_FILE=secrets/token.json
# заполняется scripts/upload_template.py; не в config.yaml: ссылка на файл открывает публичную папку
GOOGLE_TEMPLATE_SHEET_ID=
# пароль веб-панели (не короче 12 символов); обязателен, если панель слушает не только localhost (Docker).
# В одинарных кавычках: docker compose подставляет $VAR в значениях .env и молча обрезал бы пароль с «$»
PANEL_PASSWORD=''
# Docker: uid/gid владельца папок runtime/ (по умолчанию 1000)
TTMON_UID=
TTMON_GID=
